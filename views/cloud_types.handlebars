<section class="page-header">
  <div>
    <h2 class="page-title">Cloud Guide</h2>
    <p class="page-subtitle">
      What kind of cloud am I looking at? Use this reference to help you become a cloud connoisseur!
    </p>
  </div>
</section>
{{! Photo-card grid: each card uses the cloud type's real photo as a full
    background image, with a gradient overlay so the text stays readable }}
<div class="cloud-grid">
  {{#each cloudTypes as |cloudType|}}
    <div class="cloud-card">
      <img src="{{cloudType.image_url}}" alt="{{cloudType.name}}" class="cloud-card__bg" />
      <div class="cloud-card__overlay"></div>
      <div class="cloud-card__content">
        <h3 class="cloud-card__title">{{cloudType.name}}</h3>
        <p class="cloud-card__meta">{{cloudType.altitude_range}}</p>
        <p class="cloud-card__desc">{{cloudType.description}}</p>
        <p class="cloud-card__fact">{{cloudType.fun_fact}}</p>
      </div>
    </div>
  {{/each}}
</div>