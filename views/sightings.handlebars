<section class="page-header">
  <div>
    <h2 class="page-title">Catches</h2>
    <p class="page-subtitle">Who caught what?</p>
  </div>
</section>

{{! Form that submits to POST /sightings in controllers/sightingRoutes.js }}
<section class="card">
  <div class="card__header">
    <h3 class="card__title">Log a Catch</h3>
  </div>

  <form method="POST" action="/sightings" class="form">
    {{! Dropdown built from every user in the users table }}
    <label for="user_id">Who caught it?</label>
    <select name="user_id" id="user_id" required>
      {{#each users as |user|}}
        <option value="{{user.id}}">{{user.name}}</option>
      {{/each}}
    </select>

    <label for="cloud_type_id">Which cloud type?</label>
    <select name="cloud_type_id" id="cloud_type_id" required>
      {{#each cloudTypes as |cloudType|}}
        <option value="{{cloudType.id}}">{{cloudType.name}}</option>
      {{/each}}
    </select>

    <label for="location">Location</label>
    <input type="text" name="location" id="location" placeholder="Backyard, park, etc." required />

    <label for="notes">Notes</label>
    <input type="text" name="notes" id="notes" placeholder="Optional notes" />

    {{! Filled in automatically by public/js/geolocation.js before submit }}
    <input type="hidden" name="lat" id="lat" />
    <input type="hidden" name="lon" id="lon" />

    <button type="submit" class="btn btn--primary">Log Catch</button>
  </form>
</section>

<section class="card">
  <div class="card__header">
    <h3 class="card__title">Catches</h3>
    <span class="badge">{{sightings.length}} total</span>
  </div>

  <div class="catch-list">
    {{#each sightings as |sighting|}}
      <div class="catch-row">
        <img src="{{sighting.cloud_type.image_url}}" alt="{{sighting.cloud_type.name}}" class="catch-row__photo" />
        <div class="catch-row__body">
          <div class="catch-row__title">{{sighting.cloud_type.name}}</div>
          <div class="catch-row__meta-grid">
            <div class="list__meta-row">
              <span class="list__meta-label">Caught by</span>
              <span>{{sighting.user.name}}</span>
            </div>
            <div class="list__meta-row">
              <span class="list__meta-label">Location</span>
              <span>{{sighting.location}}</span>
            </div>
            <div class="list__meta-row">
              <span class="list__meta-label">Notes</span>
              <span>{{#if sighting.notes}}{{sighting.notes}}{{else}}&mdash;{{/if}}</span>
            </div>
            {{! Only shows if the weather API call succeeded when this was logged }}
            {{#if sighting.weather_snapshot}}
              <div class="list__meta-row">
                <span class="list__meta-label">Weather</span>
                <span>{{sighting.weather_snapshot.temp}}&deg;F, {{sighting.weather_snapshot.conditions}}</span>
              </div>
              <div class="list__meta-row">
                <span class="list__meta-label">Cloud Cover</span>
                <span>{{sighting.weather_snapshot.cloud_cover}}%</span>
              </div>
              <div class="list__meta-row">
                <span class="list__meta-label">Humidity</span>
                <span>{{sighting.weather_snapshot.humidity}}%</span>
              </div>
              <div class="list__meta-row">
                <span class="list__meta-label">Wind</span>
                <span>{{sighting.weather_snapshot.wind_speed}} mph {{sighting.weather_snapshot.wind_direction}}</span>
              </div>
              <div class="list__meta-row">
                <span class="list__meta-label">Pressure</span>
                <span>{{sighting.weather_snapshot.air_pressure}} hPa</span>
              </div>
            {{/if}}
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</section>
