<section class="page-header">
  <div>
    <h2 class="page-title">Catches</h2>
    <p class="page-subtitle">What's up there?</p>
  </div>
</section>

{{! Form that submits to POST /sightings in controllers/sightingRoutes.js }}
{{#if logged_in}}
<section class="card">
  <div class="card__header">
    <h3 class="card__title">Log a Catch</h3>
  </div>

  <form method="POST" action="/sightings" enctype="multipart/form-data" class="form">
  
    {{#if uploadError}}
      <p class="form-error" role="alert">{{uploadError}}</p>
    {{/if}}

    <label for="cloud_type_id">Which cloud type?</label>
    <select name="cloud_type_id" id="cloud_type_id" required>
      {{#each cloudTypes as |cloudType|}}
        <option value="{{cloudType.id}}">{{cloudType.name}}</option>
      {{/each}}
    </select>

    <label for="location">Location</label>
    <input type="text" name="location" id="location" placeholder="Backyard, park, etc." required />

    <label for="notes">Notes</label>
    <input type="text" name="notes" id="notes" placeholder="Optional notes" />

    <label for="photo">Photo (optional)</label>
    <input type="file" name="photo" id="photo" accept="image/*" />

    {{! Filled in automatically by public/js/geolocation.js before submit }}
    <input type="hidden" name="lat" id="lat" />
    <input type="hidden" name="lon" id="lon" />

    <button type="submit" class="btn btn--primary">Log Catch</button>
  </form>
</section>

{{else}}
  <p class="hint"><a href="/login">Log in</a> to log a catch.</p>
{{/if}}

<section class="card">
  <div class="card__header">
    <h3 class="card__title">Catches</h3>
    {{!-- <span class="badge">{{sightings.length}} total</span> --}}
  </div>

  <div class="catch-list">
    {{#each sightings as |sighting|}}
      <article class="catch-card">
        <img src="{{#if sighting.image_url}}{{sighting.image_url}}{{else}}{{sighting.cloud_type.image_url}}{{/if}}" alt="{{sighting.cloud_type.name}}" class="catch-card__photo" />

        <div class="catch-card__body">
          <h4 class="catch-card__title">{{sighting.cloud_type.name}}</h4>
          <p class="catch-card__caught-by">caught by {{sighting.user.name}}</p>

          <p class="catch-card__details">
            {{sighting.location}}{{#if sighting.notes}} &middot; {{sighting.notes}}{{/if}}
          </p>

          <div class="catch-card__footer">
            {{! Only shows if the weather API call succeeded when this was logged }}
            {{#if sighting.weather_snapshot}}
              <details class="catch-card__weather">
                <summary>Weather details</summary>
                <ul>
                  <li>{{sighting.weather_snapshot.temp}}&deg;F, {{sighting.weather_snapshot.conditions}}</li>
                  <li>{{sighting.weather_snapshot.cloud_cover}}% cloud cover</li>
                  <li>{{sighting.weather_snapshot.humidity}}% humidity</li>
                  <li>Wind {{sighting.weather_snapshot.wind_speed}} mph {{sighting.weather_snapshot.wind_direction}}</li>
                  <li>{{sighting.weather_snapshot.air_pressure}} hPa pressure</li>
                </ul>
              </details>
            {{/if}}

            {{#if sighting.canDelete}}
              <form method="POST" action="/sightings/{{sighting.id}}/delete" class="catch-card__delete" onsubmit="return confirm('Let this cloud float away forever?');">
                <button type="submit" class="btn catch-card__delete-btn">Delete</button>
              </form>
            {{/if}}
          </div>
        </div>
      </article>
    {{/each}}
  </div>
</section>
