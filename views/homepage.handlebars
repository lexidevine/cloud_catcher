{{! Landing page - shows live counts pulled from the database via homeRoutes.js }}
<section class="page-header">
  <div>
    <h2 class="page-title">Welcome to Cloud Catcher</h2>
    <p class="page-subtitle">
      A field guide and log for cloud lovers. Learn to identify what's overhead, then catch and record the clouds you spot.
    </p>
  </div>
</section>

<section class="card">
  <div class="card__header">
    <h3 class="card__title">Get Started</h3>
  </div>

  {{! Two link cards: one to the cloud guide, one to the catch log }}
  <div class="list">
    <div class="list__row">
      <div class="list__left">
        <div>
          <div class="list__title">Cloud Guide</div>
          <div class="list__meta">
            <span class="muted">Browse {{cloudTypeCount}} cloud types and learn what to look for.</span>
          </div>
        </div>
      </div>
      <div class="list__right">
        <a class="btn btn--primary" href="/cloud-types">Explore the Guide</a>
      </div>
    </div>

    <div class="list__row">
      <div class="list__left">
        <div>
          <div class="list__title">Catch Log</div>
          <div class="list__meta">
            <span class="muted">{{sightingCount}} clouds caught so far. Log your own.</span>
          </div>
        </div>
      </div>
      <div class="list__right">
        <a class="btn btn--primary" href="/sightings">Log a Catch</a>
      </div>
    </div>
  </div>
</section>
