<section class="page-header">
  <div>
    <h2 class="page-title">Welcome</h2>
    <p class="page-subtitle">Log in or create an account to start catching clouds.</p>
  </div>
</section>

{{! Form that submits to POST /users/login in controllers/userRoutes.js }}
<section class="card">
  <div class="card__header">
    <h3 class="card__title">Log In</h3>
  </div>

  <form method="POST" action="/users/login" class="form">
    <label for="login-email">Email</label>
    <input type="email" name="email" id="login-email" required />

    <label for="login-password">Password</label>
    <input type="password" name="password" id="login-password" required />

    <button type="submit" class="btn btn--primary">Log In</button>
  </form>
</section>

{{! Form that submits to POST /users/signup in controllers/userRoutes.js }}
<section class="card">
  <div class="card__header">
    <h3 class="card__title">Sign Up</h3>
  </div>

  <form method="POST" action="/users/signup" class="form">
    {{#if signupError}}
      <p class="form-error" role="alert">{{signupError}}</p>
    {{/if}}

    <label for="signup-name">Display Name</label>
    <input type="text" name="name" id="signup-name" placeholder="ex: Lexi" required />

    <label for="signup-username">Username</label>
    <input type="text" name="username" id="signup-username" pattern="[A-Za-z0-9_]{3,20}" title="3 to 20 letters, numbers, or underscores" placeholder="ex: cirrus_lexi" required />
    <div class="hint">
      <p class="hint__title">Username requirements</p>
      <ul class="hint__list">
        <li>3 to 20 characters</li>
        <li>Letters, numbers, and underscore (_) only</li>
        <li>No spaces or symbols</li>
      </ul>
    </div>

    <label for="signup-email">Email</label>
    <input type="email" name="email" id="signup-email" required />

    {{! minlength matches the len: [8] rule in models/User.js }}
    <label for="signup-password">Password</label>
    <input type="password" name="password" id="signup-password" minlength="8" placeholder="At least 8 characters" required />

    <button type="submit" class="btn btn--primary">Sign Up</button>
  </form>
</section>
